<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ruoyi.system.mapper.CompanyMapper">
    <insert id="insertCompany">
        insert into company(company_name)
        values (#{companyName})
    </insert>
    <update id="addUserToCompany">
        update scMoAnnoUser
        set company_id = #{companyID}
        where user_id = #{userID}
    </update>
    <update id="updateCompany">
        update company
        set company_name = #{companyName}
        where company_id = #{companyId}
    </update>
    <update id="removeUserFromCompany">
        update scMoAnnoUser
        set company_id = NULL
        where user_id = #{userID}
    </update>
    <delete id="deleteCompanyByID">
        delete from company
        where company_id = #{companyID}
    </delete>
    <select id="selectAllCompany" resultType="com.ruoyi.system.domain.entity.Company">
        select * from company
    </select>
    <select id="getCompanyUsers" resultType="com.ruoyi.system.domain.entity.Scmoannouser">
        select * from scmoannouser
        where company_id = #{companyID}
    </select>
    <select id="findCompanyByUserID" resultType="com.ruoyi.system.domain.entity.Company">
        SELECT
            c.*
        FROM
            scMoAnnoUser u
        LEFT JOIN
            company c ON u.company_id = c.company_id
        WHERE
            u.user_id = #{userID};
    </select>
    <select id="findCompanyByUserName" resultType="com.ruoyi.system.domain.entity.Company">
        SELECT
            c.*
        FROM
            scMoAnnoUser u
        LEFT JOIN
            company c ON u.company_id = c.company_id
        WHERE
            u.user_name = #{userName};
    </select>
    <select id="findCompanyByCompanyName" resultType="com.ruoyi.system.domain.entity.Company">
        select * from company where company_name = #{companyName}
    </select>
    <select id="selectAllCompanyIdName" resultType="java.util.Map">
        select
            company_id,
            company_name
        from company
    </select>

</mapper>