<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.LogMapper">
    <insert id="insertLog">
        insert into logs (user_id,action,log_time,importance)
        values (#{userId},#{act},now(),#{importance})
    </insert>
    <select id="findAllLogs" resultType="java.util.Map">
        SELECT u.*, l.*
        FROM scMoAnnoUser u
                 JOIN log l ON u.user_id = l.user_id;
    </select>
</mapper>