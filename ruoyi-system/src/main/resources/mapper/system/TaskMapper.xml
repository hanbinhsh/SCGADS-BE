<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ruoyi.system.mapper.TaskMapper">
    <insert id="insertTask">
        insert into scMoAnnoTask(task_name, start_time, uploader_id)
        values(#{taskName},#{startTime},#{uploaderId})
    </insert>
    <update id="updateTaskStatus">
        update scmoannotask
        set status = #{status}, details = #{details}
        where task_id = #{id}
    </update>
    <update id="updateTaskEndTime">
        update scmoannotask
        set end_time = #{time}
        where task_id = #{id}
    </update>
    <delete id="deleteTasksByTaskId">
        delete scmoannotask from scmoannotask where task_id = #{id}
    </delete>
    <delete id="deleteTasksByTaskName">
        delete scmoannotask from scmoannotask where task_name = #{taskName}
    </delete>
    <select id="findTasksByUserId" resultType="com.ruoyi.system.domain.entity.Scmoannotask">
        select * from scmoannotask where uploader_id = #{id}
    </select>
    <select id="findAllTasksWithUserInformation" resultType="java.util.Map">
        SELECT u.*, t.*
            FROM scMoAnnoUser u
            JOIN scMoAnnoTask t ON u.user_id = t.uploader_id;
    </select>
    <select id="findTaskByTaskName" resultType="com.ruoyi.system.domain.entity.Scmoannofiles">
        select * from scmoannotask where task_name = #{taskName}
    </select>
</mapper>